# ===============================
# Production profile (template)
# Copy to .env.prod and replace all placeholder values.
# Do NOT commit real secrets.
# ===============================

# App
NODE_ENV=production
APP_PORT=3000
PORT=3000
LOG_LANG=en
DB_CONNECTOR=mssql

# Auth hardening
AUTH_PROVIDER=local
API_AUTH_ALLOW_LEGACY=false
API_ENFORCE_REPORT_DEFAULTS=false
API_ENFORCE_DEFAULT_ROLE_PERMISSIONS=false
API_ENFORCE_DEFAULT_CREDENTIALS=false
API_REPORT_USER_ALIASES=report

# Replace all credentials before use
API_TOKEN=CHANGE_ME_STRONG_RANDOM_TOKEN
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
API_SERVICE_USER=serviceUserFLDNoderedDEN
API_SERVICE_PASSWORD=CHANGE_ME_SERVICE_PASSWORD
API_REPORT_USER=FLDSyncboardReport
API_REPORT_PASSWORD=CHANGE_ME_REPORT_PASSWORD

# OTP hardening (recommended)
OTP_REQUIRED_FOR_ALL_LOGINS=true
OTP_REQUIRED_FOR_ADMIN=true
OTP_SHARED_SECRET=CHANGE_ME_OTP_SHARED_SECRET
OTP_STEP_SECONDS=30
OTP_WINDOW_PAST=2
OTP_WINDOW_FUTURE=2

# Optional Entra/OIDC (enable only when configured)
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=
ENTRA_ISSUER=
ENTRA_ALLOWED_AUDIENCES=
ENTRA_OBO_DEFAULT_SCOPES=
ENTRA_FRONTEND_SCOPES=
ENTRA_REDIRECT_URI=
ENTRA_ALLOW_UNMAPPED_USERS=false

# SQL (Docker/Linux recommended)
MSSQL_TRUSTED_CONNECTION=false
MSSQL_SERVER=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=FLDSyncboardDB
MSSQL_USER=sa
MSSQL_PASSWORD=CHANGE_ME_SQL_PASSWORD
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=false
# Optional complete connection string (overrides server/user/password settings)
# MSSQL_CONNECTION_STRING=

# Reporting SQL login strict mode
SQL_REPORT_USER=FLDSyncboardReport
SQL_REPORT_PASSWORD=CHANGE_ME_SQL_REPORT_PASSWORD
MSSQL_REPORT_USER=FLDSyncboardReport
MSSQL_REPORT_PASSWORD=CHANGE_ME_SQL_REPORT_PASSWORD
SQL_REPORT_LOGIN_REQUIRED=true

# MQTT (set to false if unavailable in target environment)
MQTT_ENABLED=true
MQTT_HOST=den-plant1-uns.magna.global
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=bridge
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_REJECT_UNAUTHORIZED=true
MQTT_CA_FILE=magna_global_fullchain.pem

# PostgreSQL (used when DB_CONNECTOR=postgres)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=fldsyncboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# POSTGRES_CONNECTION_STRING=
