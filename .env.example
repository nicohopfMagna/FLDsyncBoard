# App
APP_PORT=3000
PORT=3000
LOG_LANG=en
DB_CONNECTOR=mssql

# Auth defaults (change for production)
API_TOKEN=dev-token
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=admin
API_SERVICE_USER=serviceUserFLDNoderedDEN
API_SERVICE_PASSWORD=FLD
API_REPORT_USER=report
API_REPORT_PASSWORD=report
AUTH_PROVIDER=local
API_AUTH_ALLOW_LEGACY=true

# SQL (recommended for Docker/Linux)
MSSQL_TRUSTED_CONNECTION=false
MSSQL_SERVER=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=FLDSyncboardDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
# Optional complete connection string (overrides server/user/password settings)
# MSSQL_CONNECTION_STRING=

# PostgreSQL (used when DB_CONNECTOR=postgres)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=fldsyncboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# POSTGRES_CONNECTION_STRING=

# MQTT
MQTT_ENABLED=true
MQTT_HOST=den-plant1-uns.magna.global
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=bridge
MQTT_PASSWORD=bridge
MQTT_REJECT_UNAUTHORIZED=true
# Optional CA file path inside container or project root
MQTT_CA_FILE=magna_global_fullchain.pem
